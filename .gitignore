# Environment / secrets
.env
.env.*
!.env.example

# PHP dependencies
/vendor/

# Front-end dependencies and generated build outputs
/node_modules/
/public/build/
/public/css/filament/
/public/fonts-manifest.dev.json
/public/fonts/filament/
/public/hot
/public/js/filament/
/public/storage

# Runtime / Laravel-generated data
/storage/app/private/*
/storage/app/backups/*
/storage/app/uploads/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/storage/*.key
/storage/pail/

# Keep directory placeholders if/when created
!/storage/app/private/.gitignore
!/storage/app/backups/.gitignore
!/storage/app/uploads/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# Tests / reports
.phpunit.result.cache
/coverage/
/playwright-report/
/test-results/
/database/*.sqlite
/.phpunit.cache/

# Release artifacts
/dist/
/releases/
*.zip
*.sha256

# IDE / OS
/.codex/
/.cursor/
/.idea/
/.nova/
/.vscode/
/.zed/
.DS_Store
Thumbs.db
Desktop.ini

# Local developer metadata
.phpactor.json
/auth.json
_ide_helper.php
Homestead.json
Homestead.yaml

# Local temporary files
*.tmp
*.swp
*.swo
