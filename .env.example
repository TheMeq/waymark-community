# This file is a safe configuration contract only. Never put real credentials in Git.
# Exact framework-generated keys and defaults will be completed during implementation planning.

APP_NAME="Waymark Community"
APP_ENV=local
WAYMARK_STAGING=false
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/London

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waymark
DB_USERNAME=waymark
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=waymark-community-session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

WAYMARK_BACKUP_DISK=backups
WAYMARK_BACKUP_RETENTION_COUNT=14
WAYMARK_RECOVERY_TOKEN_HASH=
WAYMARK_RELEASE_METADATA_URL=
WAYMARK_RELEASE_PUBLIC_KEY_BASE64=

VITE_APP_NAME="${APP_NAME}"

# Optional integrations are configured only when enabled.
ANALYTICS_PROVIDER=none
ANTISPAM_PROVIDER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WEATHER_PROVIDER=none
BACKUP_EXTERNAL_DRIVER=none
